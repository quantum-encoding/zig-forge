#!/bin/bash
# chronos-push [-m "message" | -F <file>] [-C <repo>] [remote] [branch]
#   — the explicit "ship it" command.
#
# As you work, every tool action leaves a [CHRONOS] tick commit. When you're
# ready to publish, run this: it removes ALL ticks from the unpushed range and
# pushes a tick-free history.
#
# How the fold works: git trees are cumulative snapshots, so a real commit's tree
# already contains the changes of the ticks committed below it. We therefore
# replay the real commits onto a tick-free chain (re-using their existing trees)
# and drop the ticks — each real commit absorbs the ticks beneath it, with no
# diff replay and no conflicts. This also folds ticks STRANDED below a manual
# commit. Ticks trailing above the last real commit collapse into one summary
# commit (message: your -m, or an auto summary of the ticks' actions).
#
#   chronos-push                       # auto summary, push origin/<branch>
#   chronos-push -m "feat: add X"      # your subject for the trailing summary
#   chronos-push -F msg.md             # message from a FILE (see below)
#   chronos-push -C ~/work/other-repo -m "fix: y"
#   chronos-push -m "fix: y" origin dev
#
# -F <file> exists because -m travels through the shell: a message containing
# backticks or $(...) is command-substituted on the way in, silently, and you
# only find out by reading the pushed log. A file is read verbatim — no
# expansion, no quoting rules, and multi-line bodies work as written. "-" reads
# stdin, so heredocs work:
#     chronos-push -F - <<'EOF'
#     subject line
#
#     body with backticks and $(command) left completely alone
#     EOF
#
# -C <repo> runs against another working tree, so a sibling repo ships without
# cd-ing (and without the cd sticking to your shell).
#
# Why a command and not a git hook: a pre-push hook cannot rewrite what gets
# pushed (git locks the push SHA before the hook runs — verified). So WE rewrite,
# then call git push.
set -euo pipefail

msg_override=""
msg_from_file=""
repo_dir=""
# Flags in any order, before the positional remote/branch.
while true; do
  case "${1:-}" in
    -m) msg_override="${2:-}"; shift 2 ;;
    -F|--message-file) msg_from_file="${2:-}"; shift 2 ;;
    -C|--repo|--git-repo) repo_dir="${2:-}"; shift 2 ;;
    *) break ;;
  esac
done

# Read the message BEFORE any cd, so a relative path means what the caller
# typed it against.
if [ -n "$msg_from_file" ]; then
  if [ -n "$msg_override" ]; then
    echo "chronos-push: use -m or -F, not both" >&2; exit 1
  fi
  if [ "$msg_from_file" = "-" ]; then
    msg_override="$(cat)"
  else
    [ -r "$msg_from_file" ] || { echo "chronos-push: cannot read $msg_from_file" >&2; exit 1; }
    msg_override="$(cat -- "$msg_from_file")"
  fi
  case "$msg_override" in
    *[![:space:]]*) : ;;
    *) echo "chronos-push: $msg_from_file is empty" >&2; exit 1 ;;
  esac
fi

if [ -n "$repo_dir" ]; then
  cd -- "$repo_dir" || { echo "chronos-push: cannot cd to $repo_dir" >&2; exit 1; }
fi

git rev-parse --git-dir >/dev/null 2>&1 || { echo "chronos-push: not a git repo" >&2; exit 1; }
remote="${1:-origin}"
branch="${2:-$(git symbolic-ref --short -q HEAD || true)}"
[ -n "$branch" ] || { echo "chronos-push: detached HEAD — specify a branch" >&2; exit 1; }

# Protect uncommitted work: the rewrite ends in `git reset --soft`, but refuse if
# the tree is dirty so nothing can be lost by surprise.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "chronos-push: working tree has uncommitted changes — commit or stash first" >&2
  exit 1
fi

# Rewrite base = furthest-back point we may safely rewrite. Prefer the pushed tip
# (rewrite only unpushed history); fall back to the nearest non-tick ancestor.
upstream="${remote}/${branch}"
if git rev-parse --verify -q "$upstream" >/dev/null 2>&1; then
  base=$(git rev-parse "$upstream")
else
  h=$(git rev-parse HEAD); base=""
  while [ -n "$h" ]; do
    case "$(git log -1 --format=%s "$h" 2>/dev/null)" in
      "[CHRONOS]"* | "[CHRONOS:"*) h=$(git rev-parse "$h^" 2>/dev/null || echo "") ;;
      "")           break ;;
      *)            base="$h"; break ;;
    esac
  done
  [ -n "$base" ] || base=$(git rev-list --max-parents=0 HEAD | tail -1)
fi

# Match legacy [CHRONOS] and per-agent [CHRONOS:claude]/[CHRONOS:grok]/… ticks.
ticks_total=$(git log --format=%s "${base}..HEAD" 2>/dev/null | grep -cE '^\[CHRONOS(:[A-Za-z0-9_-]+)?\]' || true)

if [ "${ticks_total:-0}" -eq 0 ]; then
  echo "chronos-push: no ticks to fold"
  # No ticks means no trailing summary commit for -m to title. Discarding a
  # message someone wrote on purpose is the defect (a real fix once shipped to
  # shared main as "wip: …" because the real subject was dropped). So apply it
  # to the unpushed tip: retitle via plumbing (commit-tree + reset --soft) so the
  # chronos post-commit hook does NOT lay a fresh tick that the leak guard would
  # then refuse to push. If the tip is already pushed there is nothing to title
  # and nothing to ship — refuse rather than push a message the caller never
  # chose, or rewrite already-pushed history.
  if [ -n "$msg_override" ]; then
    if git rev-parse --verify -q "$upstream" >/dev/null 2>&1 \
       && git merge-base --is-ancestor HEAD "$upstream" 2>/dev/null; then
      echo "chronos-push: ERROR — -m given but HEAD is already pushed to ${upstream}" >&2
      echo "               and there are no ticks to fold into a new summary. Nothing to title;" >&2
      echo "               refusing to push a message you never chose. Create a new commit" >&2
      echo "               (or amend an unpushed one) and rerun." >&2
      exit 1
    fi
    tip_tree=$(git rev-parse 'HEAD^{tree}')
    tip_parent=$(git rev-parse --verify -q 'HEAD^' 2>/dev/null || true)
    if [ -n "$tip_parent" ]; then
      new_head=$(git commit-tree "$tip_tree" -p "$tip_parent" -m "$msg_override")
    else
      new_head=$(git commit-tree "$tip_tree" -m "$msg_override")
    fi
    if [ "$(git rev-parse "${new_head}^{tree}")" != "$tip_tree" ]; then
      echo "chronos-push: ERROR — retitle changed the working tree; aborting, no changes made" >&2
      exit 1
    fi
    git reset --soft "$new_head"
    echo "chronos-push: applied -m to unpushed tip -> $(git rev-parse --short HEAD)"
  fi
else
  # No merges in the range — the cumulative-tree reasoning assumes linear history.
  if [ -n "$(git rev-list --merges "${base}..HEAD" 2>/dev/null)" ]; then
    echo "chronos-push: ERROR — merge commits in ${base}..HEAD; refusing to rewrite. Squash manually." >&2
    exit 1
  fi

  # Human span for the elapsed trailer. Bash 3.2 (macOS) — no printf %(%s)T.
  chronos_span() {
    if   [ "$1" -lt 60 ];   then printf '%ds' "$1"
    elif [ "$1" -lt 3600 ]; then printf '%dm%02ds' $(( $1 / 60 )) $(( $1 % 60 ))
    else                         printf '%dh%02dm' $(( $1 / 3600 )) $(( ($1 % 3600) / 60 )); fi
  }

  new_head="$base"
  pending=0          # unfolded ticks waiting for a real commit to absorb them
  tip_tree=""        # tree of the most recent tick (for the trailing summary)
  descs=()           # trailing ticks' action descriptions
  # When the trailing run of ticks began and ended, and how many there are.
  # The agent narrating this work has no clock and estimates elapsed time from
  # how much happened — measured, that runs long by multiples — so the duration
  # in the shipped commit comes from the ticks' own author dates instead.
  tick_n=0; tick_first_at=""; tick_last_at=""; tick_first_iso=""; tick_last_iso=""
  while read -r sha; do
    subj=$(git log -1 --format=%s "$sha")
    tree=$(git rev-parse "${sha}^{tree}")
    case "$subj" in
      "[CHRONOS]"* | "[CHRONOS:"*)
        pending=1; tip_tree="$tree"
        read -r _at _iso <<< "$(git log -1 --format='%at %aI' "$sha")"
        [ -z "$tick_first_at" ] && { tick_first_at="$_at"; tick_first_iso="$_iso"; }
        tick_last_at="$_at"; tick_last_iso="$_iso"
        tick_n=$(( tick_n + 1 ))
        # Verbose action ("Edit /path/to/file") and the cognitive state captured
        # at that tick (gerund / thinking-summary / activity), so the squash log
        # records WHAT was done and the INTENT behind it — nothing is lost.
        # The agent segment (::claude::/::grok::/…) is matched generically so the
        # state extraction works regardless of which agent authored the tick.
        d=$(printf '%s' "$subj" | sed -n 's/.* → tool-completion - \(.*\)$/\1/p')
        st=$(printf '%s' "$subj" | sed -n 's/.*::[^:]*::\([^:]*\)::TICK.*/\1/p')
        if [ -n "$d" ]; then
          if [ -n "$st" ]; then descs+=("[$st] $d"); else descs+=("$d"); fi
        fi
        ;;
      *)
        # Real commit: recreate with its own tree (already includes pending ticks),
        # re-parented onto the tick-free chain. Message preserved verbatim.
        new_head=$(git commit-tree "$tree" -p "$new_head" -m "$(git log -1 --format=%B "$sha")")
        pending=0; descs=(); tip_tree="$tree"
        tick_n=0; tick_first_at=""; tick_last_at=""; tick_first_iso=""; tick_last_iso=""
        ;;
    esac
  done < <(git rev-list --reverse "${base}..HEAD")

  if [ "$pending" = 1 ]; then
    # Trailing ticks -> one summary commit carrying the tip tree (== HEAD tree).
    if [ "${#descs[@]}" -gt 0 ]; then
      body=$(printf -- '- %s\n' "${descs[@]}")
    else
      body="- (no recorded tool descriptions)"
    fi
    # How long the folded run actually took, as git trailers so it survives
    # `git log --format=%(trailers)` and can be summed across commits later —
    # prose in the body cannot be. Two ticks minimum: a single tick has no span,
    # and "0s" would be a measurement of nothing.
    #
    # ELAPSED, never "worked". This is the wall clock between the first and last
    # tick of the run, so a fold that straddles lunch says so. Naming it work
    # would trade the model's overestimate for a machine-flavoured one, which is
    # worse — it reads as authoritative. A long span against few ticks is real
    # signal about how the session went, not noise to smooth away.
    trailers=""
    if [ "$tick_n" -ge 2 ] && [ -n "$tick_first_at" ] && [ -n "$tick_last_at" ]; then
      elapsed=$(( tick_last_at - tick_first_at ))
      if [ "$elapsed" -gt 0 ]; then
        trailers="

Chronos-Elapsed: $(chronos_span "$elapsed")
Chronos-Ticks: ${tick_n} (${tick_first_iso} → ${tick_last_iso})"
      fi
    fi
    if [ -n "$msg_override" ]; then
      smsg="${msg_override}

${body}

[chronos] squashed trailing ticks.${trailers}"
    else
      smsg="chronos: session summary — $(date '+%Y-%m-%d %H:%M')

${body}

[chronos] squashed trailing ticks.${trailers}"
    fi
    new_head=$(git commit-tree "$tip_tree" -p "$new_head" -m "$smsg")
  elif [ -n "$msg_override" ]; then
    echo "chronos-push: note: -m ignored — all ticks folded into existing commits" >&2
  fi

  # Safety: the rewritten tip MUST have the exact same tree as HEAD (content
  # preserved). If not, abort before touching the branch ref.
  if [ "$(git rev-parse "${new_head}^{tree}")" != "$(git rev-parse 'HEAD^{tree}')" ]; then
    echo "chronos-push: ERROR — rewrite changed the working tree; aborting, no changes made" >&2
    exit 1
  fi
  git reset --soft "$new_head"
  echo "chronos-push: folded ${ticks_total} tick(s) -> $(git rev-list --count "${base}..HEAD") commit(s) above $(git rev-parse --short "$base")"
fi

# Leak guard: never push if any [CHRONOS] tick would still reach the remote.
if git rev-parse --verify -q "$upstream" >/dev/null 2>&1; then
  remaining=$(git log --format=%s "${upstream}..HEAD" 2>/dev/null | grep -cE '^\[CHRONOS(:[A-Za-z0-9_-]+)?\]' || true)
  if [ "${remaining:-0}" -gt 0 ]; then
    echo "chronos-push: ERROR — ${remaining} [CHRONOS] tick(s) still present after fold; refusing to push." >&2
    exit 1
  fi
fi

echo "chronos-push: pushing ${branch} -> ${remote} ..."
git push "$remote" "$branch"
