#!/bin/bash
# Install chronos-hook symlinks in all git repositories
# This script can be installed globally in /usr/local/bin

# Resolve the installed chronos-hook: env override, then PATH, then the historical
# /usr/local/bin default — so this works for a per-user (~/.local/bin) install too.
HOOK_BINARY="${CHRONOS_HOOK_BIN:-$(command -v chronos-hook 2>/dev/null || echo /usr/local/bin/chronos-hook)}"

if [ ! -x "$HOOK_BINARY" ]; then
    echo "❌ chronos-hook not found/executable at $HOOK_BINARY"
    echo "Please install it first (chronos-installer/install.sh), or set CHRONOS_HOOK_BIN."
    exit 1
fi

echo "🔍 Searching for git repositories in $HOME..."
echo ""

count=0
find "$HOME" -name ".git" -type d 2>/dev/null | while read -r git_dir; do
    repo_dir=$(dirname "$git_dir")

    # Skip if not a directory or not accessible
    [ ! -d "$repo_dir" ] && continue

    # Create .claude/hooks directory
    hooks_dir="$repo_dir/.claude/hooks"
    mkdir -p "$hooks_dir"

    # Create symlink to global hook binary. `ln -sf` atomically replaces any
    # existing symlink, so no separate (blocked-on-some-boxes) `rm` is needed.
    hook_file="$hooks_dir/tool-result-hook.sh"
    ln -sf "$HOOK_BINARY" "$hook_file"

    count=$((count + 1))
    echo "✅ $repo_dir"
done

echo ""
echo "🎉 chronos-hook symlinks installed in all repositories!"
echo ""
echo "Benefits of this approach:"
echo "  ✅ Single binary - update once, applies everywhere"
echo "  ✅ Faster execution (compiled Zig vs bash)"
echo "  ✅ Better error handling"
echo "  ✅ Consistent behavior across all projects"
echo ""
echo "The unwrit moment is now written everywhere, efficiently."
