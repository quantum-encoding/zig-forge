#!/bin/bash
# chronos-enable-repo [REPO_DIR] — opt a git repo in to chronos ticking + squash.
#
#   1. git config chronos.enabled true   -> chronos-hook starts committing a
#      [CHRONOS] tick after each tool call in this repo (and ONLY this repo).
#   2. git config chronos.autopush <on>  -> whether the squash auto-pushes.
#   3. Installs .git/hooks/post-commit as a shim that execs the global
#      /usr/local/bin/chronos-post-commit squasher. An existing, non-chronos
#      post-commit hook is preserved and chained.
#
# Usage:
#   chronos-enable-repo                 # current repo, autopush ON
#   chronos-enable-repo /path/to/repo   # named repo
#   CHRONOS_AUTOPUSH=false chronos-enable-repo   # enable without auto-push
set -euo pipefail

repo="${1:-$(pwd)}"
cd "$repo"
git rev-parse --git-dir >/dev/null 2>&1 || { echo "error: not a git repo: $repo" >&2; exit 1; }

autopush="${CHRONOS_AUTOPUSH:-true}"
git config chronos.enabled true
git config chronos.autopush "$autopush"

hookdir="$(git rev-parse --git-path hooks)"
mkdir -p "$hookdir"
target="$hookdir/post-commit"

shim_marker="# >>> chronos post-commit shim >>>"
if [ -e "$target" ] && ! grep -qF "$shim_marker" "$target" 2>/dev/null; then
  # Preserve an existing unrelated post-commit hook and chain to it.
  cp "$target" "$target.pre-chronos"
  {
    echo "#!/bin/bash"
    echo "$shim_marker"
    echo '"$(git rev-parse --git-path hooks)/post-commit.pre-chronos" "$@" || true'
    echo 'exec /usr/local/bin/chronos-post-commit "$@"'
  } > "$target"
else
  {
    echo "#!/bin/bash"
    echo "$shim_marker"
    echo 'exec /usr/local/bin/chronos-post-commit "$@"'
  } > "$target"
fi
chmod +x "$target"

echo "chronos: enabled in $repo (autopush=$autopush)"
echo "  ticking:  git config chronos.enabled  -> $(git config --get chronos.enabled)"
echo "  squash:   $target -> /usr/local/bin/chronos-post-commit"
