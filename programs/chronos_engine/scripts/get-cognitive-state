#!/bin/bash
# Get Real-Time Cognitive State for Chronos Git Stamps
#
# Reads the live cognitive state recorded by the cognitive-watcher daemon and
# prints the bare gerund (e.g. "Pollinating", "Spelunking") used in chronos
# commit stamps. Prints "NOT-DETECTED" when no state can be resolved.
#
# Usage: get-cognitive-state [PID]
#   If PID is provided, use it directly
#   Otherwise, walk up the process tree to find Claude

DB_PATH="/var/lib/cognitive-watcher/cognitive-states.db"

# Get parent Claude Code PID
get_claude_pid() {
    # Method 1: Walk up process tree looking for "claude"
    local pid=$$
    local max_depth=20
    local depth=0

    while [ $pid -ne 1 ] && [ $depth -lt $max_depth ]; do
        local comm=$(cat /proc/$pid/comm 2>/dev/null)
        local cmdline=$(cat /proc/$pid/cmdline 2>/dev/null | tr '\0' ' ')

        # Match the real Claude Code process: comm=="claude" (native binary) or
        # a cmdline that names the Claude Code CLI by path. We deliberately do
        # NOT match a bare "claude-code" substring, because helper processes in
        # our own call chain (e.g. `chronos-stamp claude-code tool-completion`)
        # carry that token as an argument and would otherwise be mis-detected as
        # the Claude process — resolving to a PID with no cognitive state.
        if [[ "$comm" == "claude" ]] \
           || [[ "$cmdline" == *"@anthropic/claude-code"* ]] \
           || [[ "$cmdline" == *"/claude-code/"* ]]; then
            echo $pid
            return 0
        fi

        # Get parent PID
        local ppid=$(awk '{print $4}' /proc/$pid/stat 2>/dev/null)
        if [ -z "$ppid" ] || [ "$ppid" = "0" ]; then
            break
        fi
        pid=$ppid
        depth=$((depth + 1))
    done

    # Method 2: Fall back to the most recently active PID known to the watcher.
    # Uses cognitive_sessions (the live V2 table); the legacy cognitive_states
    # table is no longer written for active sessions.
    local recent_pid=$(sqlite3 "$DB_PATH" "SELECT pid FROM cognitive_sessions ORDER BY id DESC LIMIT 1;" 2>/dev/null)
    if [ -n "$recent_pid" ]; then
        echo "$recent_pid"
        return 0
    fi

    echo ""
}

# Resolve the current cognitive state for a Claude PID.
get_state_from_db() {
    local claude_pid=${1:-$(get_claude_pid)}

    if [ -z "$claude_pid" ]; then
        echo "NOT-DETECTED"
        return
    fi

    # Primary source (cognitive-watcher V2): the watcher already detects and
    # parses the spinner state and records one row per state segment in the
    # cognitive_sessions table. The newest row for this PID is the current
    # state, pre-parsed to a clean gerund ("Pollinating", "Synthesizing", ...).
    # This is authoritative and replaces the fragile raw-TTY parsing below.
    local v2_state=$(sqlite3 "$DB_PATH" "
        SELECT cognitive_state
        FROM cognitive_sessions
        WHERE pid=$claude_pid
        ORDER BY id DESC
        LIMIT 1;" 2>/dev/null)
    if [ -n "$v2_state" ]; then
        echo "$v2_state"
        return
    fi

    # Legacy fallback: parse raw TTY spinner frames from cognitive_states.
    # Claude Code's spinner has used two formats over time:
    #   OLD (pre-2026): " Elucidating (esc to interrupt  1m 32s   2.1k tokens)"
    #   NEW (current):  "✶ Skedaddling…30"  (glyph + gerund + … + elapsed secs)
    # Match either: a letter immediately before "…" (GLOB excludes bare counter
    # frames like "…42"), or the legacy "(esc to interrupt" marker.
    local raw_content=$(sqlite3 "$DB_PATH" "
        SELECT raw_content
        FROM cognitive_states
        WHERE pid=$claude_pid
          AND (raw_content GLOB '*[A-Za-z]…*'
               OR raw_content LIKE '%(esc to interrupt%')
        ORDER BY id DESC
        LIMIT 1;" 2>/dev/null)

    # Take the spinner line, drop everything from "…"/"(esc to interrupt" on,
    # then strip the leading glyph/whitespace and any trailing whitespace.
    # The leading-glyph strip is byte-oriented so it works in C and UTF-8 locales.
    local cognitive_state=$(printf '%s' "$raw_content" \
        | grep -m1 -E '…|esc to interrupt' \
        | sed -E 's/….*$//; s/[[:space:]]*\(esc to interrupt.*$//' \
        | sed 's/^[^[:alpha:]]*//; s/[[:space:]]*$//')

    if [ -n "$cognitive_state" ]; then
        echo "$cognitive_state"
    else
        echo "NOT-DETECTED"
    fi
}

# Main execution
STATE=$(get_state_from_db "$1")
echo "$STATE"
