#!/bin/bash
# Get Real-Time Cognitive State for Chronos Git Stamps
# Extracts cognitive state from raw_content using the universal pattern
#
# Usage: get-cognitive-state [PID]
#   If PID is provided, use it directly
#   Otherwise, walk up process tree to find Claude

DB_PATH="/var/lib/cognitive-watcher/cognitive-states.db"

# Get parent Claude Code PID
get_claude_pid() {
    # Method 1: Walk up process tree looking for "claude"
    local pid=$$
    local max_depth=20
    local depth=0

    while [ $pid -ne 1 ] && [ $depth -lt $max_depth ]; do
        local comm=$(cat /proc/$pid/comm 2>/dev/null)
        local cmdline=$(cat /proc/$pid/cmdline 2>/dev/null | tr '\0' ' ')

        # Check if this is a Claude process
        if [[ "$comm" == "claude" ]] || [[ "$cmdline" =~ "claude-code" ]] || [[ "$cmdline" =~ "@anthropic/claude-code" ]]; then
            echo $pid
            return 0
        fi

        # Get parent PID
        local ppid=$(awk '{print $4}' /proc/$pid/stat 2>/dev/null)
        if [ -z "$ppid" ] || [ "$ppid" = "0" ]; then
            break
        fi
        pid=$ppid
        depth=$((depth + 1))
    done

    # Method 2: Find most recent active PID from database
    local recent_pid=$(sqlite3 "$DB_PATH" "SELECT pid FROM cognitive_states ORDER BY id DESC LIMIT 1;" 2>/dev/null)
    if [ -n "$recent_pid" ]; then
        echo "$recent_pid"
        return 0
    fi

    echo ""
}

# Get cognitive state from database using universal extraction pattern
#
# Claude Code's status-spinner line has changed format over time. We support both:
#   OLD (pre-2026): " Elucidating (esc to interrupt  1m 32s   2.1k tokens)"
#   NEW (current):  "✶ Skedaddling…30"   (spinner glyph + gerund + … + elapsed seconds)
# The "(esc to interrupt … tokens)" suffix was dropped from the new UI, which is
# why the old "(esc to interrupt" filter stopped matching and every stamp fell
# through to NOT-DETECTED. We now match EITHER shape and take the newest row.
get_state_from_db() {
    local claude_pid=${1:-$(get_claude_pid)}

    if [ -z "$claude_pid" ]; then
        echo "NOT-DETECTED"
        return
    fi

    # Newest row that is a real spinner frame:
    #   - NEW: a letter immediately precedes the "…" ellipsis (GLOB excludes
    #          bare "…42" counter-only frames and pure-glyph noise)
    #   - OLD: the "(esc to interrupt" marker is present
    local raw_content=$(sqlite3 "$DB_PATH" "
        SELECT raw_content
        FROM cognitive_states
        WHERE pid=$claude_pid
          AND (raw_content GLOB '*[A-Za-z]…*'
               OR raw_content LIKE '%(esc to interrupt%')
        ORDER BY id DESC
        LIMIT 1;" 2>/dev/null)

    # Extract the cognitive word:
    #   - first line carrying the spinner marker (… or "esc to interrupt")
    #   - drop everything from "…" / "(esc to interrupt" onward
    #   - strip leading spinner glyph + whitespace and any trailing whitespace
    # The leading-glyph strip is byte-oriented so it works in C and UTF-8 locales.
    local cognitive_state=$(printf '%s' "$raw_content" \
        | grep -m1 -E '…|esc to interrupt' \
        | sed -E 's/….*$//; s/[[:space:]]*\(esc to interrupt.*$//' \
        | sed 's/^[^[:alpha:]]*//; s/[[:space:]]*$//')

    if [ -n "$cognitive_state" ]; then
        echo "$cognitive_state"
    else
        echo "NOT-DETECTED"
    fi
}

# Main execution
STATE=$(get_state_from_db "$1")
echo "$STATE"
