// CORRECTIVE / OUT-OF-SCOPE SHAPES (zig-forge/CLAUDE.md §3). Two cases,
// neither of which the scanner may flag EQL-FOR-SECRETS on:
//   1. verifyNonce uses std.crypto.timing_safe.eql — the constant-time
//      comparison the rule tells you to use.
//   2. sameMime uses std.mem.eql but its name/params name NO secret, so
//      the timing channel is harmless (enum-like string equality).
const std = @import("std");

pub fn verifyNonce(expected: [32]u8, nonce: [32]u8) bool {
    return std.crypto.timing_safe.eql([32]u8, expected, nonce);
}

pub fn sameMime(a: []const u8, b: []const u8) bool {
    return std.mem.eql(u8, a, b);
}
