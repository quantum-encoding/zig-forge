// EXTERNAL ANCHOR: zig-forge/CLAUDE.md "High-signal anti-patterns" §3
// (EQL-FOR-SECRETS). Minimized from the real oidc.zig nonce SHA-256
// verification: a non-constant-time std.mem.eql inside a function
// whose name / parameters identify a secret (nonce), leaking the
// value one byte at a time via timing. MUST fire as a gating finding.
const std = @import("std");

pub fn verifyNonce(expected: []const u8, nonce: []const u8) bool {
    return std.mem.eql(u8, expected, nonce);
}
