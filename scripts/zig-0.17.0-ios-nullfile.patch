Backport of the two Apple hunks of master's lib/std/Io/Threaded.zig (0.18.0-dev.146, 2026-10-09)
onto the official 0.17.0 tarball. 0.17.0 lists .ios and .visionos among the OSes with no /dev/null
file descriptor, so std.Io.Threaded's getDevNullFd fails to compile for every iOS target that
reaches std.debug.print. Master treats iOS and visionOS as Darwin again. The WASI read-return hunk
that sits between them on master is deliberately NOT included: it changes a return type and would
break wasm32-wasi builds on 0.17.0.
Apply: cd <zig-0.17.0 install> && patch -p0 < zig-0.17.0-ios-nullfile.patch
--- lib/std/Io/Threaded.zig
+++ lib/std/Io/Threaded.zig
@@ -354,7 +354,7 @@
             }
         }
     },
-    .wasi, .ios, .tvos, .visionos, .watchos => struct {
+    .wasi, .tvos, .watchos => struct {
         fn deinit(this: @This()) void {
             _ = this;
         }
@@ -15259,9 +15259,9 @@
 }
 
 const processSpawn = switch (native_os) {
-    .wasi, .emscripten, .ios, .tvos, .visionos, .watchos => processSpawnUnsupported,
+    .wasi, .emscripten, .tvos, .watchos => processSpawnUnsupported,
     .windows => processSpawnWindows,
-    .driverkit, .maccatalyst, .macos => processSpawnDarwin,
+    .driverkit, .ios, .maccatalyst, .macos, .visionos => processSpawnDarwin,
     else => processSpawnPosix,
 };
 
